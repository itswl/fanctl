<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.fancontrol</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fanctl</string>
        <string>run</string>
        <string>--config</string>
        <string>/usr/local/etc/fancontrol.conf</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Not Background: with every core busy a Background job wakes up 0.2-0.5 s late,
         and full load is exactly when the fans need adjusting. -->
    <key>ProcessType</key>
    <string>Standard</string>

    <key>StandardOutPath</key>
    <string>/var/log/fancontrol.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fancontrol.log</string>
</dict>
</plist>
